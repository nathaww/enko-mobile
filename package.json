{
  "name": "enko",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "device-android": "expo run:android --device",
    "device-ios": "expo run:ios --device",
    "web": "expo start --web",
    "dev": "expo start --reset-cache",
    "clear": "expo start --clear",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "ios:pods": "cd ios && pod install",
    "android:gradle": "cd android && ./gradlew clean",
    "ios:rebuild": "pnpm ios:pods && expo run:ios",
    "android:rebuild": "pnpm android:gradle && expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "check-update": "expo install --check",
    "health-check": "expo-doctor",
    "build:local:android": "eas build --local --profile staging --platform android",
    "build:local:ios": "eas build --local --profile staging --platform ios",
    "build:staging:android": "eas build --profile staging --platform android",
    "build:staging:ios": "eas build --profile staging --platform ios --non-interactive",
    "build:staging": "eas build --profile staging --platform all --non-interactive",
    "build:production": "eas build --profile production --platform all --non-interactive",
    "update:staging": "eas update --channel staging --platform all --environment preview --message",
    "update:production": "eas update --channel production --platform all --environment production --message",
    "submit:staging:ios": "eas submit --platform ios --profile staging",
    "submit:production:ios": "eas submit --platform ios --profile production",
    "submit:production:android": "eas submit --platform android --profile production",
    "icons:convert": "bash scripts/convert-tab-icons.sh"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.16.1",
    "expo": "~54.0.34",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "^6.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "formik": "^2.4.9",
    "lottie-react-native": "~7.3.8",
    "lucide-react-native": "^1.16.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eas-cli": "^19.0.8",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
